# Bay State Pain Tracker environment configuration — copy to .env.local and adjust.
# Never commit real keys. The demo runs entirely on-device with the defaults below.

# Data backend: "local" (default, on-device demo storage) or "supabase" (integration-ready, not connected).
VITE_DATA_BACKEND=local

# Supabase project (only read when VITE_DATA_BACKEND=supabase).
# Use the public anon key; row-level security in supabase/schema.sql restricts every row to its owner.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional sub-path when hosting under a folder, e.g. /pain-tracker/ (build-time, read by vite.config.ts).
BASE_PATH=/
# "hash" for static hosts without an SPA fallback (the hebamoussa.com build uses it).
VITE_ROUTER=browser
